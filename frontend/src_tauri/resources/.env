# Public frontend config (safe to bundle)

# Model to display or send to backend
MODEL_NAME=gpt-4o-mini

# How many days to keep uploaded/processed files before cleanup (frontend display only)
RETENTION_DAYS=60

# Temperature used for display purposes (actual temperature controlled in backend)
MODEL_TEMPERATURE=0.3

# Default backend mapping & template file names (passed to backend requests)
MAPPING_CSV=question_mapping_template_new.csv
EXCEL_TEMPLATE=bid_checklist.xlsx

# Backend service URL (local or packaged)
BACKEND_URL=http://127.0.0.1:10000

# Optional: default concurrency setting for extraction (display only)
DEFAULT_CONCURRENCY=3