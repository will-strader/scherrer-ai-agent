{
  "package": {
    "productName": "Scherrer Bid Assistant",
    "version": "1.0.0"
  },
  "tauri": {
    "bundle": {
      "active": true,
      "targets": ["msi", "nsis"],
      "identifier": "com.scherrer.bidassistant",
      "icon": [
        "icons/icon.ico"
      ],
      "resources": [
        "resources/scherrer-bid-backend",
        "resources/.env",
        "resources/question_mapping_template_new.csv",
        "resources/bid_checklist.xlsx"
      ]
    },
    "windows": [
      {
        "title": "Scherrer AI Bid Assistant",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "allowlist": {
      "shell": {
        "all": true
      },
      "dialog": {
        "open": true,
        "save": true
      },
      "http": {
        "request": true
      }
    },
    "updater": {
      "active": false
    },
    "security": {
      "csp": "default-src 'self'; img-src 'self' blob: data:; media-src 'self' blob: data:; connect-src 'self' http://localhost:* http://127.0.0.1:* https://scherrer-ai-agent.onrender.com;"
    }
  },
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "",
    "devPath": "../dist/index.html",
    "distDir": "../dist"
  }
}